# Copy the required values into Railway variables or the app's local .env.
FUSIONSOLAR_PORTAL_URL=https://eu5.fusionsolar.huawei.com/unisso/login.action
FUSIONSOLAR_USERNAME=
FUSIONSOLAR_PASSWORD=

ANTO_URL=https://adc-monitoring.ro/
ANTO_USERNAME=
ANTO_PASSWORD=
ANTO_PLANT_NAME=CEF Anto

# Incuba uses the ADC account by default and can override it independently.
INCUBA_ADC_USERNAME=
INCUBA_ADC_PASSWORD=
INCUBA_ADC_PLANT_NAME=CEF Incuba Reproduction

# Start Fotovoltaice uses the shared ADC account and the CEF Borcea plant by default.
START_FOTOVOLTAICE_USERNAME=
START_FOTOVOLTAICE_PASSWORD=
START_FOTOVOLTAICE_PLANT_NAME=CEF Borcea

HORECO_PLANT_NAME=CEF HORECO Costesti
HORECO_REGION_NAME=region004

MM_MV_URL=https://web3.isolarcloud.eu/#/login
MM_MV_USERNAME=
MM_MV_PASSWORD=
MM_MV_PLANT_NAME=Reghin

ANASUN_URL=https://web3.isolarcloud.eu/#/login
ANASUN_USERNAME=
ANASUN_PASSWORD=
ANASUN_PLANT_NAME=AnaSun Ulmi

# Solar Energy Ulmeni: first-gate HTTP credentials and read-only WinCC login.
# Keep disabled until an Oltenita 1 live value has been validated.
ULMENI_ENABLED=false
ULMENI_URL=https://oltenita1.epgr.ro/~ViewOfThings/index.html
ULMENI_HTTP_USERNAME=
ULMENI_HTTP_PASSWORD=
ULMENI_USERNAME=
ULMENI_PASSWORD=
# Defaults to the meter's three-phase active-power sum in kW when blank.
ULMENI_ACTIVE_POWER_TAG=

# Browser profiles used by forecast-time portal retrieval.
POWER_READING_PROFILE_DIR=.playwright_profiles

# Astro uses the Aurora account by default. Set these only if it uses a
# different Aurora login from Imperial.
ASTRO_AURORA_USERNAME=
ASTRO_AURORA_PASSWORD=
ASTRO_AURORA_PLANT_NAME=PV Luna de Jos
